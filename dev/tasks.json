{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "gcc",
            "args": [
                "main.c",
                "-o", "chip8.exe",
                "-Wall", "-Wextra", "-g",
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run",
            "type": "shell",
            "command": ".\\chip8.exe",
            "dependsOn": "build",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        }
    ]
}